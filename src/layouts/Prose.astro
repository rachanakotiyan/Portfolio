---
import Base from "./Base.astro";
const { title, description, date } = Astro.props;
---

<Base title={`${title} — Portfolio`} description={description}>
  <article class="page prose">
    <p class="eyebrow"><a href="/writing">~/writing</a>{date && ` / ${date.toLocaleDateString("en", { dateStyle: "long" })}`}</p>
    <h1>{title}</h1>
    <p class="hero-copy">{description}</p>
    <div class="divider" aria-hidden="true">{"=".repeat(80)}</div>
    <slot />
  </article>
</Base>
