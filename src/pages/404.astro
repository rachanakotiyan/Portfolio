---
import Base from "../layouts/Base.astro";
import MotifCanvas from "../components/MotifCanvas.astro";
---

<Base title="404 — Not found">
  <section class="page not-found-page">
    <div class="not-found-copy">
      <p class="eyebrow">~/404</p>
      <div class="error-code">404</div>
      <h1>Page not found.</h1>
      <p>The path you followed doesn't lead anywhere (yet).</p>
      <a href="/">Return home →</a>
    </div>
    <div class="not-found-motif">
      <MotifCanvas motif="koi" opacity={0.92} parallax={3} />
    </div>
  </section>
</Base>
