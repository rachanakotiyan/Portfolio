---
import Base from "../../layouts/Base.astro";
import AsciiField from "../../components/AsciiField.astro";
import NowPlaying from "../../components/lab/NowPlaying.astro";
import Guestbook from "../../components/lab/Guestbook.astro";
import Updates from "../../components/lab/Updates.astro";
import { site } from "../../data/site";
---

<Base title={`Lab — ${site.name}`}>
  <section class="page lab-page">
    <!-- Quiet ASCII field behind the intro only -->
    <div class="lab-intro-wrap">
      <AsciiField mirrorball={false} dimmed opacityScale={0.38} class="lab-field" />
      <div class="page-intro lab-intro-text">
        <p class="eyebrow">~/lab</p>
        <h1>The back room.</h1>
        <p>Little experiments, current listens, and things that are still taking shape.</p>
      </div>
    </div>

    <div class="lab-grid">
      <NowPlaying />
      <Updates />
      <Guestbook />
    </div>
  </section>
</Base>
