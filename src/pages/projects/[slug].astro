---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={`${project.data.title} — Projects`} description={project.data.description}>
  <article class="page prose">
    <p class="eyebrow"><a href="/projects">~/projects</a> / {project.data.date.getFullYear()}</p>
    <h1>{project.data.title}</h1>
    <p class="hero-copy">{project.data.description}</p>
    <div>{project.data.tags.map((tag) => <Tag label={tag} />)}<Tag status={project.data.status} /></div>
    <div class="divider" aria-hidden="true">{"=".repeat(80)}</div>
    <Content />
    {project.data.url && <p><a href={project.data.url} target="_blank" rel="noreferrer">Visit project →</a></p>}
  </article>
</Base>
