---
import { site } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.name} home`}>~/{site.name.toLowerCase().replaceAll(" ", "")}</a>
  <div class="header-right">
    <nav class="nav-links" aria-label="Main navigation">
      {
        site.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a href={item.href} aria-current={active ? "page" : undefined}>
              <span class="marker" aria-hidden="true">{active ? "■" : "□"}</span> ~/{item.label}
            </a>
          );
        })
      }
    </nav>
    <button type="button" class="sound-toggle" aria-pressed="false" data-sound-toggle>
      sound: off
    </button>
  </div>
</header>

<script>
  import { initSoundToggle } from "../scripts/sound.js";

  const btn = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
  if (btn && btn.dataset.soundBound !== "1") {
    btn.dataset.soundBound = "1";
    initSoundToggle(btn);
  }
</script>
